# MongoDB Atlas connection string.
# Atlas Dashboard -> Cluster -> Connect -> Drivers -> Node.js
# Keep the username and password URL-encoded (e.g. @ -> %40).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name used by the app. Optional, defaults to "todo_app".
MONGODB_DB="todo_app"

# Set to "false" only when connecting to a local mongod without TLS.
# Leave unset on Atlas, where TLS is required and always on.
MONGODB_TLS="true"

# There is deliberately no AUTH_SECRET. Sessions are opaque random tokens that
# are SHA-256 hashed in MongoDB, not signed JWTs, so there is no key to keep.
# Session cookies are marked Secure in production, which requires HTTPS, i.e. Vercel.
