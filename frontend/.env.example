# MongoDB Atlas connection string.
# Atlas Dashboard -> Cluster -> Connect -> Drivers -> Node.js
# Keep the username and password URL-encoded (e.g. @ -> %40).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name used by the app.
MONGODB_DB="todo_app"

# Set to "false" only when connecting to a local mongod without TLS.
MONGODB_TLS="true"

# Secret used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
